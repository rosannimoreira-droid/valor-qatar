---
import { BUSINESS_CONFIG, buildWhatsAppUrl } from '@/config/business';
import { getAlternateLocale, getDictionary, type Locale } from '@/i18n';
import { getAlternatePath } from '@/lib/catalog';
import ValorCrest from './ValorCrest.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = getDictionary(locale);
const altLocale = getAlternateLocale(locale);
const switchHref = getAlternatePath(currentPath, altLocale);
const generalWaUrl = buildWhatsAppUrl(t.whatsappTemplates.generalEnquiry);

const navItems = [
  { href: `/${locale}/collections/`, label: t.nav.collections },
  { href: `/${locale}/collections/flowers/`, label: t.nav.flowers },
  { href: `/${locale}/collections/chocolates/`, label: t.nav.chocolates },
  { href: `/${locale}/occasions/`, label: t.nav.occasions },
  { href: `/${locale}/bespoke-hospitality/`, label: t.nav.bespoke },
  { href: `/${locale}/about/`, label: t.nav.about },
  { href: `/${locale}/contact/`, label: t.nav.contact },
];

const isCurrent = (href: string) => {
  if (href === `/${locale}/collections/` && currentPath === href) return true;
  if (href !== `/${locale}/collections/` && currentPath.startsWith(href)) return true;
  return false;
};
---

<div class="utility-strip">
  <div class="container utility-strip-inner">
    <p class="utility-notice">{t.nav.topNotice}</p>
    <a
      href={generalWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="utility-phone-link"
      data-analytics-wa="header_strip"
    >
      <Icon name="message" size={14} />
      <span>{t.nav.conciergeLabel}:</span>
      <bdi dir="ltr" class="tabular-nums">{BUSINESS_CONFIG.concierge.whatsappDisplay}</bdi>
    </a>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <button
      type="button"
      id="mobile-menu-open"
      class="mobile-menu-trigger"
      aria-label={t.nav.menuOpen}
      aria-controls="mobile-nav-drawer"
      aria-expanded="false"
    >
      <Icon name="menu" size={22} />
    </button>

    <a href={`/${locale}/`} class="brand-mark" aria-label={t.meta.siteName}>
      <span class="brand-crest-wrap">
        <ValorCrest size={30} />
      </span>
      <span class="brand-text-group">
        <span class="brand-wordmark">{locale === 'ar' ? 'فالور' : 'VALOR'}</span>
        <span class="brand-subline">{locale === 'ar' ? 'قطر • الدوحة' : 'QATAR • DOHA'}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <ul class="desktop-nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`desktop-nav-link ${isCurrent(item.href) ? 'is-active' : ''}`}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-utilities">
      <a
        href={`/${locale}/collections/#catalog-search`}
        class="utility-icon-btn"
        aria-label={t.nav.search}
        title={t.nav.search}
      >
        <Icon name="search" size={18} />
      </a>

      <a
        href={switchHref}
        class="lang-switch-link"
        hreflang={altLocale === 'ar' ? 'ar-QA' : 'en-QA'}
      >
        <Icon name="globe" size={15} />
        <span>{t.nav.switchLang}</span>
      </a>
    </div>
  </div>
</header>

<dialog id="mobile-nav-drawer" class="mobile-drawer" aria-label="Mobile navigation">
  <div class="mobile-drawer-panel">
    <div class="mobile-drawer-header">
      <span class="brand-wordmark">{locale === 'ar' ? 'فالور قطر' : 'VALOR QATAR'}</span>
      <button
        type="button"
        id="mobile-menu-close"
        class="utility-icon-btn"
        aria-label={t.nav.menuClose}
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav aria-label="Mobile links">
      <ul class="mobile-nav-list">
        <li>
          <a href={`/${locale}/`} class="mobile-nav-link">{t.nav.home}</a>
        </li>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="mobile-nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mobile-drawer-footer">
      <a href={switchHref} class="btn btn-secondary" style="width: 100%;">
        <Icon name="globe" size={16} />
        <span>{t.nav.switchLang}</span>
      </a>
      <a
        href={generalWaUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-concierge"
        style="width: 100%;"
        data-analytics-wa="mobile_drawer"
      >
        <Icon name="message" size={16} />
        <span>{t.contact.whatsappCta}</span>
      </a>
    </div>
  </div>
</dialog>

<script>
  const drawer = document.getElementById('mobile-nav-drawer') as HTMLDialogElement | null;
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');

  if (drawer && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => {
      drawer.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });

    const closeDrawer = () => {
      drawer.close();
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    };

    closeBtn.addEventListener('click', closeDrawer);
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });
    drawer.addEventListener('close', () => {
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    });
  }
</script>

<style>
  .utility-strip {
    background-color: var(--color-qatar-maroon);
    color: var(--color-canvas-ivory);
    font-size: 0.8125rem;
    padding-block: 8px;
  }

  .utility-strip-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  .utility-notice {
    font-weight: 500;
  }

  .utility-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-weight: 600;
    color: var(--color-canvas-ivory);
  }

  .utility-phone-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(10px);
    border-block-end: 1px solid var(--color-border-hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-height);
  }

  .mobile-menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: var(--color-ink-obsidian);
  }

  @media (min-width: 1024px) {
    .mobile-menu-trigger {
      display: none;
    }
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-crest-wrap {
    color: var(--color-terracotta);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .brand-text-group {
    display: flex;
    flex-direction: column;
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--color-ink-obsidian);
  }

  [dir='rtl'] .brand-wordmark {
    letter-spacing: 0;
    font-size: 1.4rem;
  }

  .brand-subline {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
    margin-block-start: 3px;
    line-height: 1.1;
  }

  [dir='rtl'] .brand-subline {
    letter-spacing: 0;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    list-style: none;
  }

  .desktop-nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-ink-obsidian);
    padding-block: 6px;
    border-block-end: 2px solid transparent;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .desktop-nav-link:hover,
  .desktop-nav-link.is-active {
    color: var(--color-terracotta);
    border-block-end-color: var(--color-terracotta);
  }

  .header-utilities {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .utility-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-hairline);
    background-color: var(--color-surface-white);
    color: var(--color-ink-obsidian);
    text-decoration: none;
    cursor: pointer;
  }

  .utility-icon-btn:hover {
    background-color: var(--color-surface-sand);
  }

  .lang-switch-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background-color: var(--color-surface-white);
    color: var(--color-ink-obsidian);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .lang-switch-link:hover {
    background-color: var(--color-surface-sand);
  }

  /* Mobile Drawer Dialog */
  .mobile-drawer {
    margin: 0;
    padding: 0;
    border: none;
    max-width: 100vw;
    max-height: 100vh;
    width: min(340px, 88vw);
    height: 100vh;
    background: var(--color-canvas-ivory);
    color: var(--color-ink-obsidian);
    box-shadow: var(--shadow-modal);
    inset-inline-start: 0;
    inset-inline-end: auto;
  }

  .mobile-drawer::backdrop {
    background: rgba(28, 24, 21, 0.55);
  }

  .mobile-drawer-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--color-border-hairline);
  }

  .mobile-nav-list {
    list-style: none;
    padding-block: var(--space-4);
    flex: 1;
  }

  .mobile-nav-link {
    display: block;
    padding: 12px 4px;
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    border-block-end: 1px solid var(--color-border-hairline);
  }

  .mobile-drawer-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
  }
</style>
