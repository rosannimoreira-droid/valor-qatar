---
import { BUSINESS_CONFIG } from '@/config/business';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.label,
    ...(item.href ? { item: `${BUSINESS_CONFIG.site.canonicalOrigin}${item.href}` } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list">
    {
      items.map((item, idx) => (
        <li class="breadcrumbs-item">
          {item.href && idx < items.length - 1 ? (
            <a href={item.href} class="breadcrumbs-link">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="breadcrumbs-current">
              {item.label}
            </span>
          )}
          {idx < items.length - 1 && (
            <span class="breadcrumbs-sep" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs {
    padding-block: var(--space-4);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs-link {
    text-decoration: none;
  }

  .breadcrumbs-link:hover {
    color: var(--color-terracotta);
    text-decoration: underline;
  }

  .breadcrumbs-current {
    color: var(--color-ink-obsidian);
    font-weight: 600;
  }

  .breadcrumbs-sep {
    color: var(--color-border-strong);
  }
</style>
