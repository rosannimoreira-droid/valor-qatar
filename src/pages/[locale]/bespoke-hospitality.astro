---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import Icon from '@/components/Icon.astro';
import { BUSINESS_CONFIG } from '@/config/business';
import { OCCASION_IDS } from '@/content/config';
import { getDictionary, type Locale } from '@/i18n';
import editorialMedia from '@/data/editorial-media.json';

export const getStaticPaths: GetStaticPaths = () => [
  { params: { locale: 'en' } },
  { params: { locale: 'ar' } },
];

const locale = (Astro.params.locale === 'ar' ? 'ar' : 'en') as Locale;
const t = getDictionary(locale);

const showcasePhoto =
  editorialMedia.find((item) => item.mediaKey === 'editorial-04-481863025') ?? editorialMedia[0];
---

<BaseLayout
  locale={locale}
  title={`${t.bespoke.title} — ${t.meta.siteName}`}
  description={t.bespoke.lead}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs
        items={[{ label: t.pdp.breadcrumbHome, href: `/${locale}/` }, { label: t.nav.bespoke }]}
      />
      <h1>{t.bespoke.title}</h1>
      <p class="page-lead prose-measure">{t.bespoke.lead}</p>
    </div>
  </section>

  <section class="section">
    <div class="container bespoke-layout">
      <form
        id="bespoke-wizard"
        class="bespoke-form"
        data-locale={locale}
        data-phone={BUSINESS_CONFIG.concierge.whatsappDigits}
        data-template={t.whatsappTemplates.bespokeEnquiry}
      >
        <div class="wizard-group">
          <label for="bespoke-occasion" class="wizard-label">{t.bespoke.stepOccasion}</label>
          <select id="bespoke-occasion" name="occasion" class="wizard-control">
            {
              OCCASION_IDS.map((occId) => (
                <option value={t.occasions[occId].name}>{t.occasions[occId].name}</option>
              ))
            }
          </select>
        </div>

        <fieldset class="wizard-group">
          <legend class="wizard-label">{t.bespoke.stepPresentation}</legend>
          <div class="choice-list">
            {
              t.bespoke.presentationChoices.map((choice, idx) => (
                <label class="choice-option">
                  <input
                    type="radio"
                    name="presentation"
                    value={choice.label}
                    checked={idx === 0}
                  />
                  <span>{choice.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="wizard-group">
          <legend class="wizard-label">{t.bespoke.stepCategoryMix}</legend>
          <div class="choice-list">
            {
              t.bespoke.mixChoices.map((choice, idx) => (
                <label class="choice-option">
                  <input type="checkbox" name="mix" value={choice.label} checked={idx === 0} />
                  <span>{choice.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="wizard-group">
          <label for="bespoke-scale" class="wizard-label">{t.bespoke.stepScale}</label>
          <input
            type="text"
            id="bespoke-scale"
            name="scale"
            class="wizard-control"
            placeholder={t.bespoke.scalePlaceholder}
          />
        </div>

        <div class="wizard-group">
          <label for="bespoke-calligraphy" class="wizard-label">{t.bespoke.stepCalligraphy}</label>
          <input
            type="text"
            id="bespoke-calligraphy"
            name="calligraphy"
            class="wizard-control"
            placeholder={t.bespoke.calligraphyPlaceholder}
          />
        </div>

        <div class="wizard-group">
          <label for="bespoke-notes" class="wizard-label">{t.bespoke.stepDateNotes}</label>
          <textarea
            id="bespoke-notes"
            name="notes"
            rows="3"
            class="wizard-control wizard-textarea"
            placeholder={t.bespoke.dateNotesPlaceholder}></textarea>
        </div>

        <div class="wizard-submit-wrap">
          <a
            id="bespoke-whatsapp-btn"
            href={`https://wa.me/${BUSINESS_CONFIG.concierge.whatsappDigits}?text=${encodeURIComponent(t.whatsappTemplates.generalEnquiry)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-concierge bespoke-submit-btn"
          >
            <Icon name="message" size={18} />
            <span>{t.bespoke.submitCta}</span>
          </a>
          <p class="wizard-disclaimer">{t.bespoke.disclaimer}</p>
        </div>
      </form>

      <aside class="bespoke-aside">
        <div class="bespoke-photo">
          <ResponsiveImage
            mediaKey={showcasePhoto.mediaKey}
            alt={t.bespoke.title}
            width={showcasePhoto.width}
            height={showcasePhoto.height}
            sizes="(max-width: 899px) 92vw, 38vw"
            imgClass="bespoke-img"
          />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  function initBespokeWizard() {
    const form = document.getElementById('bespoke-wizard') as HTMLFormElement | null;
    const submitBtn = document.getElementById('bespoke-whatsapp-btn') as HTMLAnchorElement | null;
    if (!form || !submitBtn) return;

    const locale = (form.dataset.locale === 'ar' ? 'ar' : 'en') as 'en' | 'ar';
    const phone = form.dataset.phone || '';
    const template = form.dataset.template || '';
    const notSpecified = locale === 'ar' ? 'يتم التحديد مع فريق الضيافة' : 'To be advised';

    function updateBriefUrl() {
      const occasionEl = document.getElementById('bespoke-occasion') as HTMLSelectElement | null;
      const presentationEl = form!.querySelector<HTMLInputElement>(
        'input[name="presentation"]:checked'
      );
      const mixEls = Array.from(
        form!.querySelectorAll<HTMLInputElement>('input[name="mix"]:checked')
      );
      const scaleEl = document.getElementById('bespoke-scale') as HTMLInputElement | null;
      const calligraphyEl = document.getElementById(
        'bespoke-calligraphy'
      ) as HTMLInputElement | null;
      const notesEl = document.getElementById('bespoke-notes') as HTMLTextAreaElement | null;

      const mixText = mixEls.length > 0 ? mixEls.map((el) => el.value).join(', ') : notSpecified;

      const message = template
        .replace('{occasion}', occasionEl?.value || notSpecified)
        .replace('{presentation}', presentationEl?.value || notSpecified)
        .replace('{mix}', mixText)
        .replace('{scale}', scaleEl?.value.trim() || notSpecified)
        .replace('{calligraphy}', calligraphyEl?.value.trim() || notSpecified)
        .replace('{notes}', notesEl?.value.trim() || notSpecified);

      submitBtn!.href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
    }

    form.addEventListener('change', updateBriefUrl);
    form.addEventListener('input', updateBriefUrl);

    submitBtn.addEventListener('click', () => {
      updateBriefUrl();
      if (typeof window.valorTrack === 'function') {
        window.valorTrack('whatsapp_bespoke_click', {
          locale,
          sourceSurface: 'bespoke-wizard',
        });
      }
    });

    updateBriefUrl();
  }

  initBespokeWizard();
</script>

<style>
  .page-head {
    padding-block: var(--space-8) var(--space-6);
    background-color: var(--color-surface-sand);
    border-block-end: 1px solid var(--color-border-hairline);
  }

  .page-lead {
    margin-block-start: var(--space-3);
    color: var(--color-ink-muted);
    font-size: 1.0625rem;
  }

  .bespoke-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 900px) {
    .bespoke-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-12);
    }
  }

  .bespoke-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-6);
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
  }

  .wizard-group {
    border: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wizard-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-obsidian);
  }

  .wizard-control {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-canvas-ivory);
    font-size: 0.9375rem;
  }

  .wizard-textarea {
    resize: vertical;
    min-height: 92px;
  }

  .choice-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .choice-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--color-canvas-ivory);
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .choice-option:has(input:checked) {
    border-color: var(--color-terracotta);
    background-color: var(--color-terracotta-tint);
  }

  .choice-option input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-terracotta);
    flex-shrink: 0;
  }

  .wizard-submit-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  .bespoke-submit-btn {
    width: 100%;
    padding-block: 14px;
  }

  .wizard-disclaimer {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .bespoke-aside {
    position: sticky;
    top: calc(var(--header-height) + var(--space-6));
  }

  .bespoke-photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-hairline);
    background-color: var(--color-surface-sand);
  }

  .bespoke-photo :global(.bespoke-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
