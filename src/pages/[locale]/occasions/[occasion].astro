---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCatalogueBrowser from '@/components/ProductCatalogueBrowser.astro';
import { OCCASION_IDS, type OccasionId } from '@/content/config';
import { getDictionary, type Locale } from '@/i18n';
import { getPublishedProducts } from '@/lib/catalog';

export const getStaticPaths: GetStaticPaths = () => {
  const paths: Array<{ params: { locale: Locale; occasion: OccasionId } }> = [];
  for (const locale of ['en', 'ar'] as const) {
    for (const occasion of OCCASION_IDS) {
      paths.push({ params: { locale, occasion } });
    }
  }
  return paths;
};

const locale = (Astro.params.locale === 'ar' ? 'ar' : 'en') as Locale;
const occasion = Astro.params.occasion as OccasionId;
const t = getDictionary(locale);

const allProducts = await getPublishedProducts();
const products = allProducts.filter((p) => p.data.occasions.includes(occasion));
const occInfo = t.occasions[occasion];
---

<BaseLayout
  locale={locale}
  title={`${occInfo.name} — ${t.meta.siteName}`}
  description={occInfo.shortDesc}
>
  <ProductCatalogueBrowser
    locale={locale}
    products={products}
    title={occInfo.name}
    lead={occInfo.shortDesc}
    breadcrumbs={[
      { label: t.pdp.breadcrumbHome, href: `/${locale}/` },
      { label: t.nav.occasions, href: `/${locale}/occasions/` },
      { label: occInfo.name },
    ]}
    activeOccasion={occasion}
    showCategoryTabs={false}
    showOccasionFilter={false}
  />
</BaseLayout>
