---
import { BUSINESS_CONFIG } from '@/config/business';
import { getDictionary, getDirection, type Locale } from '@/i18n';
import { getAlternatePath } from '@/lib/catalog';
import { attachAnalyticsHelper } from '@/lib/analytics';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import '@/styles/tokens.css';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const {
  locale,
  title,
  description,
  ogImage = '/media/vlr-com-014-01-703676210-1200.jpg',
  structuredData,
} = Astro.props;

const t = getDictionary(locale);
const dir = getDirection(locale);
const pageTitle = title || t.meta.defaultTitle;
const pageDescription = description || t.meta.defaultDescription;
const currentPath = Astro.url.pathname;
const canonicalUrl = `${BUSINESS_CONFIG.site.canonicalOrigin}${currentPath}`;
const enUrl = `${BUSINESS_CONFIG.site.canonicalOrigin}${getAlternatePath(currentPath, 'en')}`;
const arUrl = `${BUSINESS_CONFIG.site.canonicalOrigin}${getAlternatePath(currentPath, 'ar')}`;
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `${BUSINESS_CONFIG.site.canonicalOrigin}${ogImage}`;

// Verified-only Organization JSON-LD (omits unverified address/hours per BVR)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.meta.siteName,
  url: BUSINESS_CONFIG.site.canonicalOrigin,
  areaServed: {
    '@type': 'Country',
    name: 'Qatar',
  },
};
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-QA" href={enUrl} />
    <link rel="alternate" hreflang="ar-QA" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={locale === 'ar' ? 'ar_QA' : 'en_QA'} />

    <!-- Fonts: Editorial Roman Serif + Clean Sans + Native Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Libre+Franklin:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
    <script is:inline set:html={attachAnalyticsHelper()} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.nav.skipToContent}</a>
    <SiteHeader locale={locale} currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
