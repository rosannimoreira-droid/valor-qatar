{
  "name": "valor-qatar-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Valor Qatar — Bilingual (EN/AR) Luxury Chocolates, Floristry & Majlis Hospitality Showcase",
  "scripts": {
    "dev": "astro dev --port 4321",
    "build:media": "node scripts/build-media.mjs",
    "build": "npm run build:media && astro build",
    "preview": "astro preview --port 4321",
    "typecheck": "astro check && tsc --noEmit",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "lint": "eslint \"src/**/*.{ts,astro,js,mjs}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css,json}\" \"scripts/**/*.{js,mjs}\"",
    "format": "prettier --write \"src/**/*.{astro,ts,css,json}\" \"scripts/**/*.{js,mjs}\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.1",
    "@types/node": "^20.17.24",
    "eslint": "^9.22.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.33.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
